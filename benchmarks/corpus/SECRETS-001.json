{
  "version": 1,
  "rule": "SECRETS-001",
  "cases": [
    {
      "id": "SECRETS-001/hardcoded-api-key",
      "task": "Wire the billing client to the payment provider.",
      "expected": "FAIL",
      "rationale": "A provider key is hardcoded in source instead of read from the environment, which the Violation section names.",
      "diff": [
        "diff --git a/src/billing/config.ts b/src/billing/config.ts",
        "index 1111111..2222222 100644",
        "--- a/src/billing/config.ts",
        "+++ b/src/billing/config.ts",
        "@@ -1,3 +1,5 @@",
        "+const BILLING_API_KEY = \"billing-live-9f2c7b1e4a8d3c6f0b5e2d7a1c4f8b31\";",
        "+",
        " export function createBillingClient(): BillingClient {",
        "-  return new BillingClient({});",
        "+  return new BillingClient({ apiKey: BILLING_API_KEY });",
        " }"
      ]
    },
    {
      "id": "SECRETS-001/database-url-with-password",
      "task": "Point the app at the internal database.",
      "expected": "FAIL",
      "rationale": "A connection string that carries a password is committed in source.",
      "diff": [
        "diff --git a/src/db.ts b/src/db.ts",
        "index 3333333..4444444 100644",
        "--- a/src/db.ts",
        "+++ b/src/db.ts",
        "@@ -1,5 +1,6 @@",
        "-export const DATABASE_URL = \"postgres://localhost:5432/app\";",
        "+export const DATABASE_URL =",
        "+  \"postgres://app_user:S3cr3tP4ssw0rd@db.internal:5432/app\";",
        " ",
        " export function connect(): Connection {",
        "   return open(DATABASE_URL);",
        " }"
      ]
    },
    {
      "id": "SECRETS-001/secret-read-from-environment",
      "task": "Read the provider key from the environment.",
      "expected": "PASS",
      "rationale": "The key comes from the environment at runtime, which the Allowed section permits.",
      "diff": [
        "diff --git a/src/billing/config.ts b/src/billing/config.ts",
        "index 1111111..5555555 100644",
        "--- a/src/billing/config.ts",
        "+++ b/src/billing/config.ts",
        "@@ -1,3 +1,3 @@",
        " export function createBillingClient(): BillingClient {",
        "-  return new BillingClient({});",
        "+  return new BillingClient({ apiKey: process.env.STRIPE_API_KEY ?? \"\" });",
        " }"
      ]
    },
    {
      "id": "SECRETS-001/placeholder-token-in-test-fixture",
      "task": "Add a fixture for the billing request test.",
      "expected": "PASS",
      "rationale": "The fixture carries a documented placeholder, not a credential.",
      "diff": [
        "diff --git a/test/fixtures/billing.test.ts b/test/fixtures/billing.test.ts",
        "index 6666666..7777777 100644",
        "--- a/test/fixtures/billing.test.ts",
        "+++ b/test/fixtures/billing.test.ts",
        "@@ -1,5 +1,10 @@",
        " import { createBillingClient } from \"../../src/billing/config\";",
        " ",
        "+export const fixtureClient = createBillingClient({",
        "+  // Placeholder on purpose: the real key comes from the environment.",
        "+  apiKey: \"<token>\",",
        "+});",
        "+",
        " it(\"builds a client\", () => {",
        "   expect(fixtureClient).toBeDefined();",
        " });"
      ]
    },
    {
      "id": "SECRETS-001/example-config-with-obvious-password",
      "task": "Document the sample settings file used for local demos.",
      "expected": "WARN",
      "rationale": "A sample file carries a password value; it is obviously not real, but it is still a credential-shaped field in a committed file.",
      "diff": [
        "diff --git a/examples/settings.yaml b/examples/settings.yaml",
        "index 8888888..9999999 100644",
        "--- a/examples/settings.yaml",
        "+++ b/examples/settings.yaml",
        "@@ -1,5 +1,7 @@",
        " server:",
        "   host: localhost",
        "   port: 8080",
        "+  database:",
        "+    password: changeme",
        " logging:",
        "   level: info"
      ]
    }
  ]
}
