{
  "version": 1,
  "rule": "QUALITY-001",
  "cases": [
    {
      "id": "QUALITY-001/behavior-change-with-covering-test",
      "task": "Add a trim option to formatTitle so leading and trailing whitespace is removed before collapsing.",
      "expected": "PASS",
      "rationale": "The behavior change and a test that exercises the new option land in the same change.",
      "diff": [
        "diff --git a/src/title.ts b/src/title.ts",
        "index 1111111..2222222 100644",
        "--- a/src/title.ts",
        "+++ b/src/title.ts",
        "@@ -1,9 +1,11 @@",
        " export interface FormatTitleOptions {",
        "   readonly upper?: boolean;",
        "+  readonly trim?: boolean;",
        " }",
        " ",
        " export function formatTitle(text: string, options: FormatTitleOptions = {}): string {",
        "-  const value = options.upper ? text.toUpperCase() : text;",
        "+  const trimmed = options.trim ? text.trim() : text;",
        "+  const value = options.upper ? trimmed.toUpperCase() : trimmed;",
        " ",
        "   return value.replace(/\\s+/g, \" \");",
        " }",
        "diff --git a/test/title.test.ts b/test/title.test.ts",
        "index 3333333..4444444 100644",
        "--- a/test/title.test.ts",
        "+++ b/test/title.test.ts",
        "@@ -1,4 +1,8 @@",
        "   it(\"collapses whitespace\", () => {",
        "     expect(formatTitle(\"a  b\")).toBe(\"a b\");",
        "   });",
        "+",
        "+  it(\"trims when the trim option is set\", () => {",
        "+    expect(formatTitle(\"  a  b  \", { trim: true })).toBe(\"a b\");",
        "+  });",
        " });"
      ]
    },
    {
      "id": "QUALITY-001/reformat-without-behavior-change",
      "task": "Reformat the tokenizer module to use consistent single quotes; no behavior change is intended.",
      "expected": "PASS",
      "rationale": "A formatting-only change that keeps behavior, which the rule's Allowed section covers.",
      "diff": [
        "diff --git a/src/tokenizer.ts b/src/tokenizer.ts",
        "index 5555555..6666666 100644",
        "--- a/src/tokenizer.ts",
        "+++ b/src/tokenizer.ts",
        "@@ -1,3 +1,3 @@",
        " export function tokenize(text: string): string[] {",
        "-  return text.split(\" \").filter((part) => part !== \"\");",
        "+  return text.split(' ').filter((part) => part !== '');",
        " }"
      ]
    },
    {
      "id": "QUALITY-001/behavior-change-without-test",
      "task": "Reject empty page slices in the paginator.",
      "expected": "WARN",
      "rationale": "A validation branch changes behavior and no test is added or updated, which the rule's Violation section describes.",
      "diff": [
        "diff --git a/src/pagination.ts b/src/pagination.ts",
        "index 7777777..8888888 100644",
        "--- a/src/pagination.ts",
        "+++ b/src/pagination.ts",
        "@@ -1,6 +1,10 @@",
        " ",
        " export function slicePage<T>(items: readonly T[], page: Page): readonly T[] {",
        "+  if (page.size <= 0) {",
        "+    throw new RangeError(\"page size must be positive\");",
        "+  }",
        "+",
        "   const start = page.index * page.size;",
        " ",
        "   return items.slice(start, start + page.size);",
        " }"
      ]
    },
    {
      "id": "QUALITY-001/test-does-not-cover-the-change",
      "task": "Support negative offsets in slicePage by clamping the start index.",
      "expected": "WARN",
      "rationale": "A behavior change lands with a test, but the added test only repeats existing behavior and never exercises the new branch.",
      "diff": [
        "diff --git a/src/pagination.ts b/src/pagination.ts",
        "index 7777777..9999999 100644",
        "--- a/src/pagination.ts",
        "+++ b/src/pagination.ts",
        "@@ -1,4 +1,5 @@",
        "   const start = page.index * page.size;",
        "+  const safeStart = start < 0 ? 0 : start;",
        " ",
        "-  return items.slice(start, start + page.size);",
        "+  return items.slice(safeStart, safeStart + page.size);",
        " }",
        "diff --git a/test/pagination.test.ts b/test/pagination.test.ts",
        "index aaaaaaa..bbbbbbb 100644",
        "--- a/test/pagination.test.ts",
        "+++ b/test/pagination.test.ts",
        "@@ -1,4 +1,8 @@",
        "   it(\"returns the requested page\", () => {",
        "     expect(slicePage([1, 2, 3, 4], { index: 1, size: 2 })).toEqual([3, 4]);",
        "   });",
        "+",
        "+  it(\"returns the first page\", () => {",
        "+    expect(slicePage([1, 2, 3, 4], { index: 0, size: 2 })).toEqual([1, 2]);",
        "+  });",
        " });"
      ]
    },
    {
      "id": "QUALITY-001/refactor-covered-by-existing-tests",
      "task": "Extract the header formatting into a named helper without changing output.",
      "expected": "PASS",
      "rationale": "A refactor that keeps behavior and stays covered by the existing tests, which the Allowed section permits.",
      "diff": [
        "diff --git a/src/report.ts b/src/report.ts",
        "index ccccccc..ddddddd 100644",
        "--- a/src/report.ts",
        "+++ b/src/report.ts",
        "@@ -1,7 +1,11 @@",
        "+function renderHeadline(title: string): string {",
        "+  return `# ${title}`;",
        "+}",
        "+",
        " export function renderReport(title: string, body: string): string {",
        "-  return `# ${title}\\n\\n${body}`;",
        "+  return `${renderHeadline(title)}\\n\\n${body}`;",
        " }",
        " ",
        " export function renderReportCompact(title: string): string {",
        "-  return `# ${title}`;",
        "+  return renderHeadline(title);",
        " }"
      ]
    }
  ]
}
