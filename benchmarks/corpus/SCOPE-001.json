{
  "version": 1,
  "rule": "SCOPE-001",
  "cases": [
    {
      "id": "SCOPE-001/change-matches-the-task",
      "task": "Add a Cache-Control header to the index route.",
      "expected": "PASS",
      "rationale": "Every changed line serves the requested header and nothing else was touched.",
      "diff": [
        "diff --git a/src/routes/index.ts b/src/routes/index.ts",
        "index 1111111..2222222 100644",
        "--- a/src/routes/index.ts",
        "+++ b/src/routes/index.ts",
        "@@ -1,6 +1,7 @@",
        "   return new Response(body, {",
        "     headers: {",
        "       \"content-type\": \"text/html\",",
        "+      \"cache-control\": \"public, max-age=60\",",
        "     },",
        "   });",
        " }"
      ]
    },
    {
      "id": "SCOPE-001/mechanical-rename-required-by-the-task",
      "task": "Rename parseConfig to readConfig across the reader module.",
      "expected": "PASS",
      "rationale": "A mechanical rename of the symbol the task names, with its call sites and test updated.",
      "diff": [
        "diff --git a/src/reader.ts b/src/reader.ts",
        "index 3333333..4444444 100644",
        "--- a/src/reader.ts",
        "+++ b/src/reader.ts",
        "@@ -1,7 +1,7 @@",
        "-export function parseConfig(text: string): Config {",
        "+export function readConfig(text: string): Config {",
        "   return { entries: text.split(\"\\n\").filter(Boolean) };",
        " }",
        " ",
        " export function loadReader(text: string): Reader {",
        "-  return { config: parseConfig(text) };",
        "+  return { config: readConfig(text) };",
        " }",
        "diff --git a/test/reader.test.ts b/test/reader.test.ts",
        "index 5555555..6666666 100644",
        "--- a/test/reader.test.ts",
        "+++ b/test/reader.test.ts",
        "@@ -1,5 +1,5 @@",
        "-import { parseConfig } from \"../src/reader\";",
        "+import { readConfig } from \"../src/reader\";",
        " ",
        " it(\"reads entries\", () => {",
        "-  expect(parseConfig(\"a\\nb\").entries).toEqual([\"a\", \"b\"]);",
        "+  expect(readConfig(\"a\\nb\").entries).toEqual([\"a\", \"b\"]);",
        " });"
      ]
    },
    {
      "id": "SCOPE-001/unrequested-dependency-bump-and-formatting-sweep",
      "task": "Fix the off-by-one in slicePage.",
      "expected": "WARN",
      "rationale": "The diff also bumps an unrelated dependency and reformats a file the task never mentions.",
      "diff": [
        "diff --git a/src/pagination.ts b/src/pagination.ts",
        "index 7777777..8888888 100644",
        "--- a/src/pagination.ts",
        "+++ b/src/pagination.ts",
        "@@ -1,4 +1,4 @@",
        "   const start = page.index * page.size;",
        " ",
        "-  return items.slice(start, start + page.size);",
        "+  return items.slice(start, start + page.size + 1);",
        " }",
        "diff --git a/package.json b/package.json",
        "index 9999999..aaaaaaa 100644",
        "--- a/package.json",
        "+++ b/package.json",
        "@@ -1,4 +1,4 @@",
        "   \"dependencies\": {",
        "-    \"left-pad\": \"1.2.0\",",
        "+    \"left-pad\": \"1.3.0\",",
        "     \"zod\": \"3.23.8\"",
        "   }",
        "diff --git a/src/logger.ts b/src/logger.ts",
        "index bbbbbbb..ccccccc 100644",
        "--- a/src/logger.ts",
        "+++ b/src/logger.ts",
        "@@ -1,3 +1,3 @@",
        "-export function log(message:string):void{",
        "-  console.log(message)",
        "+export function log(message: string): void {",
        "+  console.log(message);",
        " }"
      ]
    },
    {
      "id": "SCOPE-001/unrequested-public-rename",
      "task": "Document the retry limit in the client module.",
      "expected": "WARN",
      "rationale": "The task asks for documentation, but the change also renames a public function that no one asked to touch.",
      "diff": [
        "diff --git a/src/client.ts b/src/client.ts",
        "index ddddddd..eeeeeee 100644",
        "--- a/src/client.ts",
        "+++ b/src/client.ts",
        "@@ -1,7 +1,8 @@",
        " export interface ClientOptions {",
        "-  retries?: number;",
        "+  /** How many times a failed request is retried. Defaults to 2. */",
        "+  retries?: number;",
        " }",
        " ",
        "-export function sendRequest(url: string): Promise<Response> {",
        "+export function dispatchRequest(url: string): Promise<Response> {",
        "   return fetch(url);",
        " }"
      ]
    },
    {
      "id": "SCOPE-001/test-only-change-for-the-task",
      "task": "Add a unit test for the clamp helper.",
      "expected": "PASS",
      "rationale": "The change only adds the requested test, in the file the task points at.",
      "diff": [
        "diff --git a/test/clamp.test.ts b/test/clamp.test.ts",
        "index fffffff..1234567 100644",
        "--- a/test/clamp.test.ts",
        "+++ b/test/clamp.test.ts",
        "@@ -1,5 +1,10 @@",
        " import { clamp } from \"../src/clamp\";",
        " ",
        " it(\"clamps to the bounds\", () => {",
        "   expect(clamp(5, 0, 3)).toBe(3);",
        " });",
        "+",
        "+it(\"keeps a value inside the bounds\", () => {",
        "+  expect(clamp(1, 0, 3)).toBe(1);",
        "+  expect(clamp(0, 0, 3)).toBe(0);",
        "+});"
      ]
    }
  ]
}
