{
  "name": "@jevguard/plugin",
  "version": "0.0.0",
  "private": true,
  "description": "OpenCode plugin that reviews a completed agent turn against a repository semantic rule using Jev.",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "jevguard": "./src/cli/main.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jev",
    "semantic",
    "policy",
    "typesafe"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/plugin"
  },
  "dependencies": {
    "@jevguard/core": "workspace:*",
    "@jevguard/opencode-adapter": "workspace:*",
    "@opencode-ai/plugin": "1.18.31"
  }
}
