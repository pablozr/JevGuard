{
  "name": "@pablozrrrr/jevguard",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode plugin that reviews a completed agent turn against a repository semantic rule using Jev.",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui/index.ts"
  },
  "bin": {
    "jevguard": "./src/cli/main.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablozr/JevGuard.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/pablozr/JevGuard#readme",
  "bugs": {
    "url": "https://github.com/pablozr/JevGuard/issues"
  },
  "engines": {
    "bun": ">=1.1.0",
    "opencode": ">=1.18.31 <2"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jev",
    "semantic",
    "policy",
    "typesafe"
  ],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/plugin"
  },
  "dependencies": {
    "@jevguard/core": "workspace:*",
    "@jevguard/opencode-adapter": "workspace:*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31"
  }
}
