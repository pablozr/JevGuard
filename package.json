{
  "name": "jevguard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "artifact:build": "bun packages/plugin/scripts/build-artifact.ts",
    "artifact:pack": "bun packages/plugin/scripts/pack-artifact.ts",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.20.4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
